# Какая касса за данными: iiko или saby (Saby Presto). Переключает адаптер в
# backend/pos/ — остальной код от кассы не зависит.
POS_PROVIDER=iiko

# iikoweb доступ
IIKO_WEB_URL=https://iskendi.iikoweb.ru
IIKO_WEB_LOGIN=Ataev
IIKO_WEB_PASSWORD=your_password_here
IIKO_STORE_ID=161059

# Saby (СБИС) Presto — сервисная авторизация приложения (Настройки → Безопасность →
# Подключения к Saby). Только чтение. Нужны при POS_PROVIDER=saby.
SABY_APP_CLIENT_ID=
SABY_APP_SECRET=
SABY_SECRET_KEY=
SABY_POINT_ID=283
# TTL токена Saby не документирован — держим не дольше этого, обновляем по 401.
SABY_TOKEN_TTL_SECONDS=3600
# Кэш каталога номенклатуры (он даёт категорию блюда), сек.
SABY_MENU_TTL_SECONDS=3600

# Начало истории заказов для бэкафилла (ISO). На Saby probe невозможен — задать вручную
# датой подключения кассы.
HISTORY_START_DATE=

# День, с которого данные берёт ТЕКУЩАЯ касса (ISO). Дни раньше него синк не трогает —
# они уже в БД, а новая касса о них не знает. ⚠️ Заполнить в день переезда на Saby,
# иначе первый же синк затрёт историю iiko: восстановить её будет неоткуда.
POS_SWITCH_DATE=

DATABASE_URL=sqlite:///./iskendi.db
# Сколько SQLite ждёт освобождения блокировки, прежде чем вернуть ошибку (мс).
SQLITE_BUSY_TIMEOUT_MS=5000

# Разрешённые источники CORS через запятую. На проде фронт и API за одним адресом
# (nginx проксирует /api) — CORS не участвует; список нужен для локальной разработки.
# Пусто = CORS выключен.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Максимальный размер загружаемого файла (накладные/прайсы), МБ.
MAX_UPLOAD_MB=10

# Часовой пояс ресторана: задаёт границы «сегодня/неделя/месяц» и расписание синков
# (не зависит от TZ контейнера). По умолчанию Europe/Moscow.
TIMEZONE=Europe/Moscow

# TTL in-memory кэша живых чтений из iikoweb (get-data/OLAP), сек. 0 — кэш выключен.
CACHE_TTL_SECONDS=60

# Частый синк текущего дня в БД, сек (дашборд отдаёт «сегодня» из БД). 0 — выключить.
TODAY_SYNC_SECONDS=180

# Авторизация дашборда (обязательно задать пароль — иначе вход невозможен).
# Один общий логин/пароль на весь дашборд; сессия — JWT в localStorage.
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me
# Секрет подписи JWT. Если пуст — выводится из пароля. Задайте свой для ротации сессий.
JWT_SECRET=
# Срок жизни сессии, часов.
JWT_TTL_HOURS=12

# Домен для продакшен-запуска через Caddy (docker-compose.prod.yml).
# Нужна A-запись DNS на IP сервера + открытые порты 80/443 → авто-HTTPS.
# Для dev (docker-compose.yml) не используется.
DOMAIN=analytics.example.com
